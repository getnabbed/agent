# Hardened system service for nabbed-agent.
#
#   install -m 0755 agent /usr/local/bin/nabbed-agent
#   install -m 0644 nabbed-agent.service /etc/systemd/system/
#   install -m 0644 agent.example.yaml /etc/nabbed-agent/agent.yaml   # optional
#   systemctl edit nabbed-agent   # or set NABBED_API_URL, add ReadWritePaths for media
#   systemctl enable --now nabbed-agent
#   journalctl -u nabbed-agent    # the pairing code appears here on first start

[Unit]
Description=Nabbed agent
Documentation=https://github.com/getnabbed/agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=exec
# Optional config file, read-only to the agent under ProtectSystem=strict.
Environment=NABBED_CONFIG=/etc/nabbed-agent/agent.yaml
ExecStart=/usr/local/bin/nabbed-agent --data-dir ${STATE_DIRECTORY} --log-format json run
Restart=on-failure
RestartSec=5s
# Exit 3: revoked or credentials expired. Needs re-pairing, so do not restart.
RestartPreventExitStatus=3

# Identity: a dedicated, persistent system user. Credentials in
# /var/lib/nabbed-agent are readable only by it (0700 dir, 0600 file).
DynamicUser=yes
StateDirectory=nabbed-agent
StateDirectoryMode=0700
UMask=0077

# Media and download directories must be granted explicitly, e.g.
#   ReadWritePaths=/data/media /data/downloads
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
